  <text corresp="#K1" xml:lang="ta">
    <body>
      <pb n="1r"/>
      <lg>
        <l>eṇṇiya - veṇṇiya - veytupaṟ - kaṇṇutaṟ -</l>
        <l>pavaḻa mālvarai payanta -</l>
        <l>kavaḻa yāṉaiyiṉ kaḻalpaṇi vōrē <g ref="#pcs"/></l>
      </lg>
      <lg>
        <l>tavaḻat tā<lb/>marait tātā kōvi-l</l>
        <l>vaṉaip poṟṟu maruntamiḻ kurittē <g ref="#pcs"/> -</l>
      </lg>
      <lg>
        <l>tantimukat tantai - cataṅkaip patampōṟṟuñ</l>
        <l><lb/>cintai viḻakkān tivākarattil vanta</l>
        <l>tokutiyoru paṉṉireṇṭuñ cōrāmal nērē -</l>
        <l>pakutiyu<unclear>ṟai</unclear> <unclear>naṉ</unclear>maṉamē <lb/>paṟṟu -</l>
      </lg>
      <lg>
        <l>āyakalaka ḷaṟupattu nāṉkiṉaiyumē</l>
        <l>yavuṇarviyakku meṉṉam mēṟṟūya</l>
        <l>vuruppaḻuṅku pōlvāḷeṉ ṉuḷḷat <lb/>tiṉuḷḷē -</l>
        <l>yiruppaḻiṅku - vārā tiṭar <g ref="#pcs"/></l>
      </lg>
    </body>
  </text>

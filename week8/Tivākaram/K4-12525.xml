  <text corresp="#K4" xml:lang="ta">
    <body>
      <pb n="1r"/>
      <lg>
        <l>eṇṇiya veṇṇiya veytuvaṟ kaṉṉutal</l>
        <l>pavaḷa mālvarai payiṉṟa</l>
        <l>kavaḷai yāṉaiyiṉ kaḷalpa<unclear>ṇi</unclear> vōṟa<unclear>ke</unclear> <g ref="#pcs"/></l>
      </lg>
      <lg>
        <l>tavaḷat <unclear>tā</unclear>marai tātā kōyil</l>
        <l>vaṉaip poṟṟu <gap quantity="1" unit="character" reason="lost"/><lb/>runtami<unclear>ṭ</unclear> kuṟittē</l>
      </lg>
      <lg>
        <l>tantimukat tantaic cataṅkaip patampōṟṟuñ</l>
        <l>cintai viḷakkān tivākarattu vanta</l>
        <l>tokutiyoru paṉṉiraṇṭuñ – cōṟāmal <lb/>nērē</l>
        <l>pakutiyuṟa maṉamē paṟṟu <g ref="#pcs"/></l>
      </lg>
      <lg>
        <l>āyakalai kaḷaṟu pattu ṉāṉaiyumē</l>
        <l>yavuṇar viṟku meṉṉam mētūya</l>
        <l>viruppaḷiṅku pōlvāḷe<unclear>ṉ</unclear> ṉuḷḷat tiṉuḷḷē</l>
        <l><lb/>yiruppaḷiṅku vā<unclear>ṟā</unclear> tiṭar <g ref="#pcl"/></l>
      </lg>
    </body>

  <text corresp="#C1" xml:lang="ta">
    <body>
      <pb n="1r" facs="2"/>
      <lg>
        <l>eṇṇiya veṇṇiya veytupa kaṇṇutaṟ</l>
        <l>pavaḷa mālvarai payanta</l>
        <l>kavaḷa yāṉaiyiṉ kaḻalpaṇi vōrē <g ref="#pcs"/></l>
      </lg>
      <lg>
        <l>tavaḷat tāmarait tātār kōyil</l>
        <l><lb/>vaṉaip poṟṟutu maruntamiḻ kuṟittē - <g ref="#pcs"/></l>
      </lg>
      <lg>
        <l>āyakalaikaḷ aṟupattu nāṉkiṉaiyumē</l>
        <l>vuṇarvikku meṉṉamai tūya</l>
        <l>vuruppaḷiṅku pōlvāḷeṉ ṉu<lb/>ḷḷat tiṉuḷḷē</l>
        <l>yiruppaḷiṅku vārā tiṭar - <g ref="#pcs"/> -</l>
      </lg>
      <p>civaṇ peyar -</p>
    </body>
  </text>
